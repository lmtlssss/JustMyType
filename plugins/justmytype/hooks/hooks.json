{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DATA}/hook.py\" hook",
            "commandWindows": "python \"%PLUGIN_DATA%\\hook.py\" hook",
            "timeout": 12,
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_DATA}/hook.py\" hook",
            "commandWindows": "python \"%PLUGIN_DATA%\\hook.py\" hook",
